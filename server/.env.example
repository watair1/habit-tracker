# Google AI Studio에서 발급받은 키를 아래에 붙여넣으세요 (README 참고)
GEMINI_API_KEY=

# 사용할 모델 (기본값 권장). 프리티어에서 되는 최신 모델입니다.
GEMINI_MODEL=gemini-flash-latest

# 서버 포트 (기본 3000)
PORT=3000

# 이 서버를 호출할 수 있는 사이트 (쉼표로 구분). 비워두면 아무 데서나 호출 가능해요.
# 배포했다면 꼭 채우세요. 안 그러면 남이 내 Gemini 한도를 대신 써버릴 수 있어요.
# 예: ALLOWED_ORIGINS=https://watair1.github.io
ALLOWED_ORIGINS=

# 호출 횟수 제한 (비워두면 아래 기본값)
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_PER_DAY=300

# 기본 모델이 붐벼서 계속 실패할 때 대신 물어볼 예비 모델 (기본값 gemini-flash-lite-latest).
# 이름이 안 맞으면 aistudio.google.com 의 모델 목록을 보고 바꾸세요. 비워두면 폴백을 안 써요.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# AI 를 쓸 수 있는 구글 계정 이메일 (쉼표로 구분). 비우면 누구나 쓸 수 있어요.
# 예: ALLOWED_EMAILS=me@gmail.com,friend@gmail.com
ALLOWED_EMAILS=

# 로그인 증명서를 확인할 때 쓰는 값. index.html 의 FIREBASE_CONFIG.apiKey 와 똑같이 넣으세요.
# (원래 공개되는 값이라 비밀은 아니지만, 코드에 박지 않으려고 여기로 뺐어요)
FIREBASE_WEB_API_KEY=

# ── Claude 로 바꾸기 ──────────────────────────────
# claude 로 적으면 Claude 를 써요. 비워두면 지금처럼 Gemini.
# Claude 는 쓰는 만큼 돈이 나가서, ALLOWED_EMAILS 가 비어 있으면 Claude 를 부르지 않아요.
AI_PROVIDER=

# Anthropic 콘솔에서 만든 키 (콘솔에서 월 사용 한도를 꼭 걸어두세요)
ANTHROPIC_API_KEY=

# 모델 (기본 claude-sonnet-5-5)
AI_CLAUDE_MODEL=claude-sonnet-5-5

# 생각을 얼마나 깊게 할지: low | medium | high (기본 low. 빠르고 싸요)
AI_CLAUDE_EFFORT=low
