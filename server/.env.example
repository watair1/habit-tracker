# Google AI Studio에서 발급받은 키를 아래에 붙여넣으세요 (README 참고)
GEMINI_API_KEY=

# 사용할 모델 (기본값 권장). 프리티어에서 되는 최신 모델입니다.
GEMINI_MODEL=gemini-flash-latest

# 서버 포트 (기본 3000)
PORT=3000

# 이 서버를 호출할 수 있는 사이트 (쉼표로 구분). 비워두면 아무 데서나 호출 가능해요.
# 배포했다면 꼭 채우세요. 안 그러면 남이 내 Gemini 한도를 대신 써버릴 수 있어요.
# 예: ALLOWED_ORIGINS=https://watair1.github.io
ALLOWED_ORIGINS=

# 호출 횟수 제한 (비워두면 아래 기본값)
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_PER_DAY=300
